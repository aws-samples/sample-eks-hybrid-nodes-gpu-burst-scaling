        <mxCell id="svc-gpu-op" style="sketch=0;points=[[0,0,0],[0.25,0,0],[0.5,0,0],[0.75,0,0],[1,0,0],[0,1,0],[0.25,1,0],[0.5,1,0],[0.75,1,0],[1,1,0],[0,0.25,0],[0,0.5,0],[0,0.75,0],[1,0.25,0],[1,0.5,0],[1,0.75,0]];outlineConnect=0;fontColor=#232F3E;fillColor=#01A88D;strokeColor=#ffffff;dashed=0;verticalLabelPosition=bottom;verticalAlign=top;align=center;html=1;fontSize=10;fontStyle=0;aspect=fixed;shape=mxgraph.aws4.resourceIcon;resIcon=mxgraph.aws4.generic_application;fontFamily=Helvetica;shadow=1;" value="NVIDIA GPU Operator&lt;div&gt;&lt;i&gt;DCGM Exporter&lt;/i&gt;&lt;/div&gt;" vertex="1" parent="svc-group-gpu-op">
          <mxGeometry x="36" y="30" width="48" height="48" as="geometry" />
        </mxCell>


