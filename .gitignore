# Terraform
terraform-live/.terraform/
terraform-live/.terraform.lock.hcl
terraform-live/terraform.tfstate
terraform-live/terraform.tfstate.*
terraform-live/terraform.tfvars
terraform-live/*.pem

# Ensure terraform.tfvars.example is NOT ignored
!terraform-live/terraform.tfvars.example

# Test results
tests/results/

# OS files
.DS_Store
*.swp
*~

# IDE
.idea/
.vscode/
*.code-workspace
#zz_PCRS_Review
zz_PCRS_Review

# Python
__pycache__/
*.pyc
.env

# Sensitive files that should never be committed
*.pem
*.key

# Rendered manifests (generated by terraform apply)
manifests/burst-scaling/rendered/

# Security scans reports from internal plataform
#scan-report*

# Security scan results (generated locally)
#security-scans/
